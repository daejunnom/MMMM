{
  "schemaVersion": 1,
  "allowedRootFiles": [
    ".gitignore",
    ".gitattributes",
    "AGENTS.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "NOTICE.md",
    "README.md",
    "Cargo.toml",
    "Cargo.lock",
    "rust-toolchain.toml"
  ],
  "allowedRootDirectories": [
    ".github",
    "apps",
    "contracts",
    "crates",
    "docs",
    "examples",
    "integrations",
    "jvm",
    "policies",
    "tests",
    "tools",
    "vendor"
  ],
  "forbiddenDirectoryNames": [
    ".cache",
    ".gradle",
    ".venv",
    "__pycache__",
    "build",
    "checkpoints",
    "coverage",
    "datasets",
    "dist",
    "dist-server",
    "models",
    "node_modules",
    "reports",
    "runs",
    "target",
    "tmp",
    "venv"
  ],
  "forbiddenSecretFileNames": [
    ".env",
    "credentials",
    "credentials.json",
    "service-account.json",
    "id_rsa",
    "id_ed25519"
  ],
  "forbiddenSecretFilePatterns": [
    ".env.*",
    "*credential*.json",
    "*service-account*.json",
    "*service_account*.json",
    "id_rsa*",
    "id_ed25519*",
    "*.pem",
    "*.key",
    "*.p12",
    "*.pfx"
  ],
  "forbiddenFileSuffixes": [
    ".bin",
    ".ckpt",
    ".class",
    ".db",
    ".dll",
    ".dylib",
    ".exe",
    ".jar",
    ".log",
    ".mca",
    ".mcr",
    ".nbt",
    ".o",
    ".obj",
    ".onnx",
    ".pt",
    ".pth",
    ".pyc",
    ".pyo",
    ".safetensors",
    ".so",
    ".sqlite",
    ".sqlite3",
    ".tar",
    ".tar.gz",
    ".tgz",
    ".zip"
  ],
  "forbiddenGeneratedFilePatterns": [
    "*.so.*",
    "*.dylib.*",
    "*.dmp",
    "*.hprof",
    "*.db-wal",
    "*.db-shm",
    "*.sqlite-wal",
    "*.sqlite-shm",
    "*.sqlite3-wal",
    "*.sqlite3-shm"
  ],
  "maxTrackedFileBytes": 10485760,
  "maxPolicyFileBytes": 65536,
  "pathRules": {
    "requireStageZero": true,
    "portablePaths": true,
    "rejectCaseUnicodeCollisions": true,
    "allowedGitModes": ["100644", "100755"]
  },
  "exceptions": []
}
